{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/npc.schema.json",
  "title": "Nagłówek pliku typu 'npc'",
  "description": "Karta bohatera niezależnego. Wersja kontraktu 1.0.",
  "type": "object",
  "required": [
    "id",
    "typ",
    "tytul",
    "status",
    "imie",
    "rola",
    "dom",
    "rocznik_1969",
    "kanon",
    "pewnosc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unikalny identyfikator",
      "pattern": "^npc\\.[a-z0-9-]+$"
    },
    "typ": {
      "const": "npc",
      "description": "Typ pliku"
    },
    "tytul": {
      "type": "string",
      "description": "Nazwa wyświetlana"
    },
    "status": {
      "type": "string",
      "description": "Etap pracy",
      "enum": [
        "szkic",
        "recenzja",
        "gotowe"
      ]
    },
    "tylko_mg": {
      "type": "boolean",
      "description": "Czy ukryte przed graczami (domyślnie true poza handoutami)"
    },
    "tagi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Słowa kluczowe"
    },
    "zrodla": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Źródła treści"
    },
    "aktualizacja": {
      "type": "string",
      "description": "Data ostatniej zmiany",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "imie": {
      "type": "string",
      "description": "Imię i nazwisko"
    },
    "rola": {
      "type": "string",
      "description": "Rola w kampanii, np. antagonista sceny"
    },
    "dom": {
      "type": "string",
      "description": "Dom w Hogwarcie albo 'brak'"
    },
    "rocznik_1969": {
      "type": "string",
      "description": "Np. '6 rok', 'nauczyciel', 'dorosły'"
    },
    "kanon": {
      "type": "boolean",
      "description": "Czy postać pochodzi z kanonu"
    },
    "pewnosc": {
      "type": "string",
      "description": "Poziom pewności faktów",
      "enum": [
        "kanon",
        "niepewne",
        "nasze"
      ]
    },
    "sceny": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^s[0-9]+\\.scena\\.[0-9]{2}$"
      },
      "description": "Sceny z udziałem postaci"
    }
  },
  "additionalProperties": true,
  "x-sekcje": [
    "W skrócie",
    "Wygląd i sposób bycia",
    "Głos",
    "Czego chce",
    "Sekret",
    "Sygnały",
    "Reakcje",
    "Mechanika",
    "Do weryfikacji"
  ],
  "x-referencje": {
    "sceny": [
      "scena"
    ]
  }
}

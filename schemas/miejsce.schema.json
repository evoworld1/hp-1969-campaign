{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/miejsce.schema.json",
  "title": "Nagłówek pliku typu 'miejsce'",
  "description": "Lokacja. Wersja kontraktu 1.0.",
  "type": "object",
  "required": [
    "id",
    "typ",
    "tytul",
    "status",
    "lokalizacja"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unikalny identyfikator",
      "pattern": "^miejsce\\.[a-z0-9-]+$"
    },
    "typ": {
      "const": "miejsce",
      "description": "Typ pliku"
    },
    "tytul": {
      "type": "string",
      "description": "Nazwa wyświetlana"
    },
    "status": {
      "type": "string",
      "description": "Etap pracy",
      "enum": [
        "szkic",
        "recenzja",
        "gotowe"
      ]
    },
    "tylko_mg": {
      "type": "boolean",
      "description": "Czy ukryte przed graczami (domyślnie true poza handoutami)"
    },
    "tagi": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Słowa kluczowe"
    },
    "zrodla": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Źródła treści"
    },
    "aktualizacja": {
      "type": "string",
      "description": "Data ostatniej zmiany",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "lokalizacja": {
      "type": "string",
      "description": "Np. 'Hogwart, wschodnie skrzydło'"
    },
    "sceny": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^s[0-9]+\\.scena\\.[0-9]{2}$"
      },
      "description": "Sceny"
    }
  },
  "additionalProperties": true,
  "x-sekcje": [
    "Do odczytania",
    "Dla MG",
    "Ukryte",
    "Testy"
  ],
  "x-referencje": {
    "sceny": [
      "scena"
    ]
  }
}
